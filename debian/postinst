#!/bin/sh

set -e

. /usr/share/debconf/confmodule

CONFIG=/etc/tg-sendmail.yaml
OLD_CONFIG=/etc/tg-sendmail.ini
LOGFILE=/var/log/tg-sendmail.log

# set_value key value
# Only writes when an answer was given, so that an upgrade does not wipe
# credentials the user filled in by hand.
set_value() {
	key="$1"
	value="$2"
	[ -n "$value" ] || return 0
	escaped=$(printf '%s' "$value" | sed -e 's/[\\&|]/\\&/g')
	sed -i "s|^\( *\)${key}: .*|\1${key}: \"${escaped}\"|" "$CONFIG"
}

# Carry credentials over from the INI file used before 0.4.0. Filling that file
# by hand was a documented option, so debconf does not always know the answers.
migrate_from_ini() {
	grep -q "YOUR_BOT_TOKEN_HERE\|YOUR_CHAT_ID_HERE" "$CONFIG" || return 0
	for old in "$OLD_CONFIG" "$OLD_CONFIG.dpkg-remove" "$OLD_CONFIG.dpkg-bak"; do
		[ -f "$old" ] || continue
		token=$(sed -nE 's/^[[:space:]]*bot_token[[:space:]]*=[[:space:]]*"?([^"[:space:]]+)"?.*/\1/p' "$old" | head -1)
		chat=$(sed -nE 's/^[[:space:]]*chat_id[[:space:]]*=[[:space:]]*"?([^"[:space:]]+)"?.*/\1/p' "$old" | head -1)
		set_value bot_token "$token"
		set_value chat_id "$chat"
		[ -z "$token$chat" ] || echo "tg-sendmail: migrated credentials from $old"
		break
	done
}

case "$1" in
configure)
	db_get tg-sendmail/bot-token
	set_value bot_token "$RET"

	db_get tg-sendmail/chat-id
	set_value chat_id "$RET"

	migrate_from_ini

	# Any user may send mail, so all of them must be able to append to the log.
	touch "$LOGFILE"
	chmod 666 "$LOGFILE"

	sed -i "s|^\( *\)path: .*|\1path: $LOGFILE|" "$CONFIG"
	;;
esac

#DEBHELPER#

exit 0
